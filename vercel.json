{
  "version": 2,
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/exhibit/:id",
      "destination": "/index.html"
    },
    {
      "source": "/upload",
      "destination": "/index.html"
    },
    {
      "source": "/detail",
      "destination": "/index.html"
    },
    {
      "source": "/saved",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    }
  ]
}
